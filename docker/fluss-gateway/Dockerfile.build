# Keep the release binary compatible with glibc 2.28 hosts while using the
# project's pinned Rust toolchain. Run this target on a native machine for the
# requested platform.
FROM rust:1.88-bookworm AS rust-toolchain

FROM rockylinux:8.10 AS builder

ENV CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH} \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_TOOLCHAIN=1.88.0

RUN dnf install -y \
        ca-certificates \
        gcc \
        gcc-c++ \
        make \
        perl \
        pkgconf-pkg-config \
    && dnf clean all

COPY --from=rust-toolchain /usr/local/cargo/ /usr/local/cargo/
COPY --from=rust-toolchain /usr/local/rustup/ /usr/local/rustup/

WORKDIR /workspace
COPY fluss-rust/ fluss-rust/
COPY fluss-gateway/Cargo.toml \
     fluss-gateway/Cargo.lock \
     fluss-gateway/
COPY fluss-gateway/src/ fluss-gateway/src/
COPY fluss-gateway/tests/ fluss-gateway/tests/

RUN cargo build \
    --manifest-path fluss-gateway/Cargo.toml \
    --release \
    --locked \
    --bin fluss-gateway

FROM scratch AS artifact
COPY --from=builder \
    /workspace/fluss-gateway/target/release/fluss-gateway \
    /fluss-gateway
